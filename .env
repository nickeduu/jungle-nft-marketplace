# Public, non-secret configuration (committed on purpose; Vite exposes VITE_* to the client).
# Override locally with .env.local (git-ignored).
VITE_ENABLE_MOCKS=true
VITE_API_BASE_URL=/api
# Fictitious host: socket.io-client connects here and MSW intercepts the WebSocket.
VITE_SOCKET_URL=wss://realtime.jungle.mock
